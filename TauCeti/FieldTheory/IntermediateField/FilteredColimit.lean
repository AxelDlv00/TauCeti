module

public import TauCeti.Algebra.Category.Ring.AdjoinFinset
public import TauCeti.FieldTheory.IntermediateField.Algebraic

/-!
# An algebraic extension as a filtered colimit of finite subextensions

The finite intermediate fields form a directed system under inclusion. For an algebraic
extension `L / K`, their inclusion cocone exhibits `L` as a colimit in commutative rings.
Applying `Spec` to `finiteSubextensionDiagram` gives the affine inverse system used in
finite-presentation descent of a contraction, its target and its projective embedding.

The diagram and cocone reuse the monotone-subalgebra construction underlying
`TauCeti.CommRingCat.adjoinFinsetDiagram` and `TauCeti.CommRingCat.adjoinFinsetCocone`.
Both colimit proofs use `TauCeti.CommRingCat.isColimitMonotoneSubalgebraCocone`;
in the field case, the simple subextension generated by an element gives coverage.
-/

public section

open CategoryTheory Limits

namespace TauCeti.IntermediateField

variable (K L : Type*) [Field K] [Field L] [Algebra K L]

/-- The commutative rings underlying finite intermediate fields, with their inclusions. -/
noncomputable def finiteSubextensionDiagram : ↥(finiteExts K L) ⥤ CommRingCat :=
  CommRingCat.monotoneSubalgebraDiagram K L (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra)
    (fun _ _ h ↦ h)

/-- The inclusion cocone from finite subextensions into the ambient extension. -/
noncomputable def finiteSubextensionCocone : Cocone (finiteSubextensionDiagram K L) := by
  unfold finiteSubextensionDiagram
  exact CommRingCat.monotoneSubalgebraCocone K L
    (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra) (fun _ _ h ↦ h)

/-- A stage of the finite-subextension diagram is its underlying commutative ring. -/
@[simp] theorem finiteSubextensionDiagram_obj (E : ↥(finiteExts K L)) :
    (finiteSubextensionDiagram K L).obj E = CommRingCat.of E.1 := by
  exact CommRingCat.monotoneSubalgebraDiagram_obj K L _ _ E

/-- Transition maps are inclusions of intermediate fields. -/
@[simp] theorem finiteSubextensionDiagram_map {E F : ↥(finiteExts K L)} (f : E ⟶ F) :
    eqToHom (finiteSubextensionDiagram_obj K L E).symm ≫
        (finiteSubextensionDiagram K L).map f ≫
          eqToHom (finiteSubextensionDiagram_obj K L F) =
      CommRingCat.ofHom (_root_.IntermediateField.inclusion (leOfHom f)).toRingHom := by
  exact CommRingCat.monotoneSubalgebraDiagram_map K L
    (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra) (fun _ _ h ↦ h) f

/-- The cocone point is the ambient extension. -/
@[simp] theorem finiteSubextensionCocone_pt :
    (finiteSubextensionCocone K L).pt = CommRingCat.of L := by
  exact CommRingCat.monotoneSubalgebraCocone_pt K L
    (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra) (fun _ _ h ↦ h)

/-- Cocone legs are the inclusions into the ambient extension. -/
@[simp] theorem finiteSubextensionCocone_ι_app (E : ↥(finiteExts K L)) :
    eqToHom (finiteSubextensionDiagram_obj K L E).symm ≫
        (finiteSubextensionCocone K L).ι.app E ≫
          eqToHom (finiteSubextensionCocone_pt K L) =
      CommRingCat.ofHom (algebraMap E.1 L) := by
  exact CommRingCat.monotoneSubalgebraCocone_ι_app K L
    (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra) (fun _ _ h ↦ h) E

variable [Algebra.IsAlgebraic K L]

/-- An algebraic extension is the filtered colimit of its finite intermediate fields. -/
noncomputable def isColimitFiniteSubextensionCocone :
    IsColimit (finiteSubextensionCocone K L) := by
  unfold finiteSubextensionCocone
  apply CommRingCat.isColimitMonotoneSubalgebraCocone
  intro x
  have hfinite : FiniteDimensional K (_root_.IntermediateField.adjoin K ({x} : Set L)) :=
    inferInstance
  exact ⟨⟨_root_.IntermediateField.adjoin K {x}, hfinite⟩,
    _root_.IntermediateField.subset_adjoin K _ (Set.mem_singleton x)⟩

end TauCeti.IntermediateField
